# Aucune de ces variables n'est secrète et toutes sont facultatives.

# Port HTTP écouté par le serveur (les hébergeurs le fournissent en général).
PORT=3000

# Interface d'écoute. 0.0.0.0 permet de jouer depuis un téléphone du même réseau.
HOST=0.0.0.0

# 1 derrière un proxy/hébergeur (Render, Fly.io, Railway, Nginx…) pour que la
# limitation de débit utilise la vraie adresse IP (en-tête X-Forwarded-For).
TRUST_PROXY=0

# Origines autorisées pour le temps réel, séparées par des virgules.
# Vide = même origine uniquement (cas normal : le serveur sert aussi l'interface).
ALLOWED_ORIGINS=

# Dossier du client compilé. Par défaut : dist/client à côté du serveur compilé.
# STATIC_DIR=
