# Toutes ces variables sont facultatives pour jouer : sans elles, le jeu fonctionne sans compte.
# Ne jamais versionner le fichier .env réel (il contient des secrets).

# ── Serveur ──────────────────────────────────────────────────
# Port HTTP écouté par le serveur (les hébergeurs le fournissent en général).
PORT=3000
# Interface d'écoute. 0.0.0.0 permet de jouer depuis un téléphone du même réseau.
HOST=0.0.0.0
# 1 derrière un proxy/hébergeur (Render, Fly.io, Railway, Nginx…) : la limitation de débit
# utilise alors la vraie adresse IP (en-tête X-Forwarded-For).
TRUST_PROXY=0
# Origines autorisées pour le temps réel, séparées par des virgules. Vide = même origine uniquement.
ALLOWED_ORIGINS=
# Dossier du client compilé. Par défaut : dist/client à côté du serveur compilé.
# STATIC_DIR=

# ── Données persistantes (comptes, sessions, profils, photos) ─
# Hébergeur SANS disque persistant (Render gratuit…) : base Turso gratuite, voir le README.
#   DATABASE_URL=libsql://undercover-monpseudo.turso.io
#   DATABASE_AUTH_TOKEN=<jeton créé par « turso db tokens create undercover »>
DATABASE_URL=
DATABASE_AUTH_TOKEN=
# Sans DATABASE_URL : fichier local DATA_DIR/undercover.db (à placer sur un disque qui survit aux redémarrages).
DATA_DIR=./data

# ── Comptes facultatifs ──────────────────────────────────────
# Adresse publique exacte du site, sans barre finale : liens des e-mails et retour de Google.
PUBLIC_URL=https://undercover.example.com
# Secret des sessions, 32 caractères aléatoires minimum (ex. : openssl rand -base64 32).
# Obligatoire en production (NODE_ENV=production) ; sans lui, les comptes sont désactivés.
# En développement, il est généré automatiquement dans DATA_DIR/.auth-secret.
BETTER_AUTH_SECRET=

# Envoi des e-mails (vérification d'adresse, mot de passe oublié). Sans SMTP :
# - en développement, les liens s'affichent dans le terminal ;
# - en production, l'inscription par e-mail est désactivée (rien n'est simulé).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Undercover <no-reply@undercover.example.com>"

# Connexion Google (facultative) : identifiants OAuth « Application Web » de la Google Cloud Console.
# URI de redirection autorisée à déclarer : <PUBLIC_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
